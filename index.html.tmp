import test from 'node:test'; import assert from 'node:assert/strict'; import { mkdtempSync } from 'node:fs'; import { tmpdir } from 'node:os'; import { join } from 'node:path';
import { SQLiteStore, AuthService, RateLimiter } from '../src/index.js';
test('SQLite persists users and needs',()=>{const p=join(mkdtempSync(join(tmpdir(),'py-')),'db.sqlite');let s=new SQLiteStore(p);const u=s.createUser({email:'a@b.com',skills:['dog']});const n=s.createNeed(u.id,{title:'Dog care',required_skills:['dog']});s=new SQLiteStore(p);assert.equal(s.getUser(u.id).email,'a@b.com');assert.equal(s.getNeed(n.id).title,'Dog care');});
test('auth register login and bad password',()=>{const s=new SQLiteStore(':memory:');const a=new AuthService(s);const r=a.register({email:'x@y.com',password:'a-strong-password'});assert.equal(a.authenticate(r.token).id,r.user.id);assert.equal(a.login('x@y.com','a-strong-password').user.id,r.user.id);assert.throws(()=>a.login('x@y.com','wrong-password'));});
test('rate limiter blocks overflow',()=>{const r=new RateLimiter({windowMs:10000,max:2});assert.equal(r.check('x').allowed,true);assert.equal(r.check('x').allowed,true);assert.equal(r.check('x').allowed,false);});
